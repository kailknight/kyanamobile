<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wifi signal readout in the status HUD (install-time only, no runtime prompt) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Storage (for game data on older Android) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Require OpenGL ES 3.1 -->
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />

    <!-- Keep screen on during gameplay -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Proximity voice chat. Declaring it is not enough on its own: from
         Android 6 the player must also grant it at runtime, and until they do
         SDL simply reports a capture device that will not open. Phase 5 owns
         asking. Until then the client falls back to its test tone, so the
         transport can still be exercised on a phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Declared optional so a device with no microphone at all - and the Play
         Store listing - does not treat voice chat as a requirement for
         installing a game that works perfectly well without it. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="World of Kira"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true">

        <!--
            Android 12+ signal that the game redraws correctly at whatever size
            it is given, rather than needing to be letterboxed or restarted.
            The renderer already does: SyncAndroidDrawableSizeFromSokol runs
            once per frame and rebuilds the 576p target from the current
            drawable, so a window being dragged to a new size just follows.
            Some OEM floating-window launchers (RedMagic's "hang app" among
            them) read this before they will accept an app.
        -->
        <meta-data
            android:name="android.supports_size_changes"
            android:value="true" />

        <activity
            android:name=".PreloadActivity"
            android:label="World of Kira"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|navigation|uiMode"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:keepScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MuMainNativeActivity"
            android:label="World of Kira"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|navigation|uiMode"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:keepScreenOn="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />
        </activity>

    </application>

</manifest>
