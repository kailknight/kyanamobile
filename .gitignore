# Only Source_Server-Mobi is the live project; everything else at the
# repo root is a build archive / snapshot copy, ignored by default.
/*
!/Source_Server-Mobi/
!/.gitignore

# --- Source_Server-Mobi: track only the shared engine/game source ---
# (server projects, backup copy, vendored third-party code, and loose
# debug artifacts at this level are not part of the client render work)
/Source_Server-Mobi/*
!/Source_Server-Mobi/5.Main/

/Source_Server-Mobi/5.Main/boost_1_80_0/
/Source_Server-Mobi/5.Main/dependencies/
/Source_Server-Mobi/5.Main/sdk-directx9/

# Backup copy of the source tree, not built by CMake - don't track/edit.
/Source_Server-Mobi/5.Main - Copy/

# Source_Server-Mobi/android is ALREADY its own separate git repo (its own
# .git, remote "origin" -> github.com/fittail08/kyanamobile, predates this
# outer repo) - don't nest/shadow it here as a gitlink. This outer repo is
# only a safety net for the 5.Main engine source, which has no git of its own.
/Source_Server-Mobi/android/

# Compiled artifacts if any get generated in-place.
*.o
*.obj
*.a
*.so
*.dll
*.apk
*.aab

# --- Server source: GameServer and DataServer are tracked too -------------
# Added deliberately - these carry the server half of features whose client
# half is in 5.Main (slot machine, custom store, cash shop), and they had no
# version control of any kind before this.
#
# Their CONFIG and DATA are still out: those live in Working Project and the
# MuServer trees, both ignored by the /* rule at the top, and the configs are
# environment-specific (DB DSNs, live server addresses) rather than source.
!/Source_Server-Mobi/4.GameServer/
!/Source_Server-Mobi/2.DataServer/

# ...but only their source. IDE state, build intermediates and any binary
# that lands inside those trees stay out.
/Source_Server-Mobi/4.GameServer/.vs/
/Source_Server-Mobi/2.DataServer/.vs/
/Source_Server-Mobi/4.GameServer/**/Debug/
/Source_Server-Mobi/4.GameServer/**/Release/
/Source_Server-Mobi/2.DataServer/**/Debug/
/Source_Server-Mobi/2.DataServer/**/Release/
/Source_Server-Mobi/4.GameServer/**/*.suo
/Source_Server-Mobi/2.DataServer/**/*.suo
/Source_Server-Mobi/4.GameServer/**/*.user
/Source_Server-Mobi/2.DataServer/**/*.user
# .aps is the resource editor's binary cache, regenerated from the .rc.
# .prerename is a stray editor backup, not source.
/Source_Server-Mobi/4.GameServer/**/*.aps
/Source_Server-Mobi/2.DataServer/**/*.aps
/Source_Server-Mobi/4.GameServer/**/*.prerename
